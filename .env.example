# =============================================
# 环境变量配置
# 复制此文件为 .env，填入真实值
# .env 文件不要提交到 Git
# =============================================

# =============================================
# 豆包 Ark（火山方舟）— 默认使用
# 获取地址：https://console.volcengine.com/ark/
# =============================================

# API Key（必填）
DOUBAO_API_KEY=your-doubao-ark-api-key

# 模型 ID（必填，注意：豆包 Ark 的 model 参数填的是接入点 ID，不是模型名）
# 接入点 ID 通常以 ep- 开头，在「模型推理 → 接入点管理」里创建和查看
DOUBAO_MODEL=your-endpoint-id

# API 端点（默认北京区域）
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 温度参数（可选，默认 0.7）
# 0   = 更确定，代码生成推荐
# 0.7 = 均衡，日常任务推荐
# 1.0 = 更发散，内容创作推荐
DOUBAO_TEMPERATURE=0.7

# =============================================
# DeepSeek — 可切换使用
# 获取地址：https://platform.deepseek.com/
# 代码里通过 baseUrl + apiKey 切换即可
# =============================================

# DEEPSEEK_API_KEY=sk-your-deepseek-api-key
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_TEMPERATURE=0.7

# =============================================
# Tavily 搜索 API（可选，demo-search 需要）
# 获取地址：https://app.tavily.com/
# 免费额度：每月 1000 次搜索
# =============================================

TAVILY_API_KEY=tvly-your-tavily-api-key
